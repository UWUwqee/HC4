# Optional providers for grounded natural-language website answers.
# Create a key at https://openrouter.ai/keys and configure it server-side in Vercel.
# If neither provider key is set, the built-in website responder handles supported questions.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_MODEL="openrouter/free"
# Optional fallback provider if OpenRouter is unavailable or returns an ungrounded answer.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Turso appointment storage. Keep these server-side; never use VITE_ prefixes.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="replace-with-a-new-token"

# Clerk authentication.
# Add the publishable key as VITE_CLERK_PUBLISHABLE_KEY or NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"
# Keep this server-side. Never add a secret key to a VITE_ variable.
CLERK_SECRET_KEY="sk_test_your_secret_key"

# Comma-separated Clerk admin emails or user IDs.
ADMIN_EMAILS="mrfloreshealthcenter@gmail.com"
ADMIN_USER_IDS="user_your_clerk_user_id"

# Vercel Cron authenticates the scheduled in-site appointment reminder endpoint with this secret.
CRON_SECRET="generate-a-long-random-secret"
