# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Clerk public key for browser sign-in.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your-publishable-key"

# Clerk secret key for server-side session verification.
# Keep this server-side; never use a VITE_ prefix.
CLERK_SECRET_KEY="sk_test_your-secret-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Turso appointment storage. Keep these server-side; never use VITE_ prefixes.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="replace-with-a-new-token"

# Comma-separated Clerk email addresses permitted to manage appointments.
ADMIN_EMAILS="admin@example.com"

# Optional comma-separated Clerk user IDs permitted to manage appointments.
ADMIN_USER_IDS="user_example"

# Vercel Cron authenticates the scheduled in-site appointment reminder endpoint with this secret.
CRON_SECRET="generate-a-long-random-secret"
